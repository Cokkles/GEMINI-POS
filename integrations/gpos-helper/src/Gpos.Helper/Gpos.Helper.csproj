<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gpos-helper</AssemblyName>
    <RootNamespace>Gpos.Helper</RootNamespace>
    <Version>0.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == 'win-x64'">Assets\aegis-mark.ico</ApplicationIcon>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
  </PropertyGroup>
</Project>

