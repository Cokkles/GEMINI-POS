{
  "Helper": {
    "ListenAddress": "127.0.0.1",
    "Port": 47831,
    "AppsScriptEndpoint": "",
    "UpstreamTimeoutSeconds": 15,
    "UpstreamMaxRetries": 2,
    "SessionMinutes": 60,
    "HeartbeatSeconds": 30,
    "MaxRequestBodyBytes": 65536,
    "MaxUpstreamResponseBytes": 1048576,
    "DevelopmentMode": false,
    "LaunchBrowser": true,
    "AllowedOrigins": [
      "https://cokkles.github.io"
    ],
    "AllowedEmails": [],
    "SecretStorePath": "/var/lib/gpos-helper/secrets",
    "SecretStoreKeyFile": "/run/secrets/gpos_helper_key",
    "GoogleOAuth": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://127.0.0.1:47831/api/v1/auth/callback",
      "Scopes": [
        "openid",
        "email",
        "profile"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  }
}

